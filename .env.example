# ============================================
# MultimodalQA Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Zhipu AI (GLM-4.6V) - Required
# Get your API key at: https://open.bigmodel.cn/
ZHIPUAI_API_KEY=your_api_key_here

# HuggingFace Hub - Windows only (fixes symlink privilege issue)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Model Settings (defaults work fine, only change if needed)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_USE_FP16=true

# Paths (relative to project root, defaults work fine)
DATA_DIR=./data
VECTOR_STORE_DIR=./vector_store
DOC_STORE_DIR=./doc_store
UPLOAD_DIR=./uploads
